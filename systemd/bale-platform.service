[Unit]
Description=Hermes Agent — Bale userbot adapter (Shape C)
Documentation=https://github.com/PlayTalk-ir/bale-adapter
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bale-adapter
EnvironmentFile=/opt/bale-adapter/.env
EnvironmentFile=-/opt/bale-adapter/.env.secrets
# Userbot session file is created by scripts/login.py on the VPS console.
# The runner refuses to start if the session file is missing — it will not
# trigger aiobale's interactive PhoneLoginCLI (which would block forever).
ExecStartPre=/usr/local/bin/bale-adapter-bootstrap.sh
ExecStart=/opt/bale-adapter/venv/bin/python -m bale_platform.runner
Restart=always
RestartSec=5
TimeoutStartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
