# Docker Compose — copy to `.env` and adjust.
# Joins an existing Laravel stack network (no published host ports).

# Required: name of the external Docker network Laravel uses
LARAVEL_DOCKER_NETWORK=steach_laravel

# --- Paths inside the container (match volume mounts in docker-compose.yml) ---
BALE_SESSION_PATH=/app/.session/session.bale
BALE_STORE_PATH=/app/data/support_inbox.sqlite
BALE_OUTBOX_PATH=/app/data/outbox.sqlite
BALE_KB_DIR=/app/kb
BALE_LOG_FILE=/app/logs/userbot.log

# --- HTTP API (reachable as http://bale-adapter:8787 from Laravel containers) ---
BALE_API_ENABLED=true
BALE_API_HOST=0.0.0.0
BALE_API_PORT=8787

# Safe defaults until you deliberately go live (see docs/deploy-docker.md)
BALE_OBSERVE_ONLY=true
BALE_SENDING_PAUSED=true
BALE_SEND_MODE=dry_run

BALE_DEFAULT_TTL_S=86400
BALE_API_RATE_PER_MIN=60
BALE_QUEUE_MAX=500
